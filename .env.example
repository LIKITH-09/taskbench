# Copy to .env (git-ignored) and fill in only what you use.
# Local model via Ollama: no key needed. Default base URL shown.
OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional paid providers (only for the optional paid-model run):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Inspect writes raw logs here by default; TaskBench passes logs/<run_id> explicitly.
# INSPECT_LOG_DIR=./logs
